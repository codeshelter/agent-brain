{
  "mcpServers": {
    "jira-onprem": {
      "command": "uvx",
      "args": ["mcp-atlassian"],
      "env": {
        "JIRA_URL": "${user_config.jira_url}",
        "JIRA_PERSONAL_TOKEN": "${user_config.jira_token}"
      }
    },
    "jira-portfolio": {
      "command": "uv",
      "args": ["run", "--with", "mcp<2", "python", "${CLAUDE_PLUGIN_ROOT}/mcp/jira_portfolio_mcp.py"],
      "env": {
        "JIRA_URL": "${user_config.jira_url}",
        "JIRA_AUTH_TYPE": "token",
        "JIRA_PERSONAL_TOKEN": "${user_config.jira_token}"
      }
    },
    "redmine": {
      "command": "uv",
      "args": ["run", "--with", "mcp<2", "python", "${CLAUDE_PLUGIN_ROOT}/mcp/redmine_mcp.py"],
      "env": {
        "REDMINE_URL": "${user_config.redmine_url}",
        "REDMINE_AUTH_TYPE": "token",
        "REDMINE_API_KEY": "${user_config.redmine_api_key}"
      }
    },
    "nexus": {
      "command": "uv",
      "args": ["run", "--with", "mcp<2", "python", "${CLAUDE_PLUGIN_ROOT}/mcp/nexus_mcp.py"],
      "env": {
        "NEXUS_URL": "${user_config.nexus_url}",
        "NEXUS_AUTH_TYPE": "basic",
        "NEXUS_USERNAME": "${user_config.nexus_username}",
        "NEXUS_PASSWORD": "${user_config.nexus_password}"
      }
    }
  }
}
