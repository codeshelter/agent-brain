#!/bin/sh
# Rejects commit messages that carry an AI/agent footer (rules/git-commits.md).
# Install in any repo: cp <plugin>/tools/commit-msg <repo>/.git/hooks/commit-msg
if grep -qiE '^(co-authored-by:.*(claude|anthropic|openai|copilot|gpt|gemini|cursor)|claude-session:)|generated (with|by) .*(claude|ai\b|copilot|gpt)|\xf0\x9f\xa4\x96' "$1"; then
  echo "commit-msg: AI/agent footer or attribution found; remove it (rules/git-commits.md)." >&2
  grep -niE '^(co-authored-by:|claude-session:)|generated (with|by)|\xf0\x9f\xa4\x96' "$1" >&2
  exit 1
fi
exit 0
